{
  "api_version": "1.0.0",
  "description": "Checked-in wire schema descriptions consumed by scripts/generate_ui_contracts.py. tests/scripts/test_generate_ui_contracts.py validates these against the live app.plugins.schema enums and gateway envelope shape, so this file cannot drift from the backend.",
  "enums": {
    "ValueKind": [
      "boolean",
      "integer",
      "number",
      "text",
      "enum",
      "object",
      "aligned_series"
    ],
    "Unit": ["none", "percent", "currency", "points", "seconds", "bars", "ratio"],
    "Alignment": ["none", "index", "timestamp", "bar_index"],
    "WidgetKind": [
      "numeric_input",
      "slider",
      "text_input",
      "dropdown",
      "checkbox"
    ],
    "OptimizationScale": ["linear", "logarithmic", "step"],
    "OptimizationDistribution": ["uniform", "normal"]
  },
  "envelope": {
    "top_level_keys": ["api_version", "request_id", "status", "data", "error"],
    "success_status": "success",
    "error_status": "error",
    "error_object_keys": ["code", "message", "issues"]
  },
  "routes": [
    "GET /api/v1/health",
    "GET /api/v1/catalog",
    "POST /api/v1/catalog/select",
    "POST /api/v1/graphs/validate",
    "POST /api/v1/executions/evaluate",
    "POST /api/v1/executions/batch",
    "POST /api/v1/exports"
  ]
}
