			<category name="Comparisons" key="IndyComparisons" showOnTop="true" comparison="true">
				<item key="IsGreater" name="Is Greater ( &gt; )" returnType="boolean" parameterSet="ValuesSet" display="#Left# &gt; #Right#" />
