				<item key="IsGreaterOrEqual" name="Is Greater or equal ( &gt;= )" returnType="boolean" parameterSet="ValuesSet" display="#Left# &gt;= #Right#" />
				<item key="IsLowerOrEqual" name="Is Lower or equal ( &lt;= )" returnType="boolean" parameterSet="ValuesSet" display="#Left# &lt;= #Right#" />
				<item key="Equals" name="Equals ( = )" returnType="boolean" parameterSet="ValuesSet" display="#Left# = #Right#" />
				<item key="NotEquals" name="Not Equals (  &lt;&gt; )" returnType="boolean" parameterSet="ValuesSet" display="#Left# &lt;&gt; #Right#" />
				<item key="CrossesAbove" name="Crosses Above" returnType="boolean" parameterSet="ValuesSet" display="#Left# crosses above #Right#" />
