    <AdvancedTypes>
      <AdvancedType key="priceFormula">
        <Item key="From formula" controlType="Formula">
          <addfield key="Formula" type="double" controlType="Formula" />
        </Item>
      </AdvancedType>
      <AdvancedType key="slptFormula">
        <Item key="None" />
        <Item key="Use global SL / PT" />
        <Item key="Define own fixed value">
          <addfield key="FixedProfit" type="int" minValue="1" maxValue="999999" controlType="jspinnerVar" defaultValue="50" step="5" postfix="pips" />
        </Item>
        <Item key="Define own ATR based value">
          <addfield key="Value" type="double" minValue="0.01" maxValue="99999" controlType="editbox" defaultValue="1" step="0.1" postfix="* ATR(" />
          <addfield key="Atr" type="int" minValue="1" maxValue="999999" controlType="jspinnerVar" defaultValue="50" step="5" postfix=")" />
        </Item>
        <Item key="Value from variable (in pips)">
          <addfield key="Variable" type="int" controlType="comboVar" />
        </Item>
        <Item key="Value from formula (in pips)">
          <addfield key="Variable" type="int" controlType="comboVar" />
        </Item>
        <Item key="Custom range">
          <addfield key="Formula" type="double" controlType="Formula" />
        </Item>        <Item key="Level from variable">
          <addfield key="Variable" type="int" controlType="comboVar" />
        </Item>
        <Item key="Level from formula">
          <addfield key="Formula" type="double" controlType="Formula" />
        </Item>
      </AdvancedType>
      <AdvancedType key="trailFormula">
        <Item key="None" />
        <Item key="Fixed value (in pips)">
          <addfield key="FixedProfit" type="int" minValue="1" maxValue="999999" controlType="jspinnerVar" defaultValue="50" step="5" postfix="pips" />
        </Item>
        <Item key="ATR-based">
          <addfield key="Value" type="double" minValue="0.01" maxValue="99999" controlType="editbox" defaultValue="1" step="0.1" postfix="* ATR(" />
          <addfield key="Atr" type="int" minValue="1" maxValue="999999" controlType="jspinnerVar" defaultValue="50" step="5" postfix=")" />
        </Item>
        <Item key="Range from variable (in pips)">
          <addfield key="Variable" type="int" controlType="comboVar" />
        </Item>
        <Item key="Custom range (in pips)">
          <addfield key="Formula" type="double" controlType="Formula" />
        </Item>
        <Item key="Level from variable">
          <addfield key="Variable" type="int" controlType="comboVar" />
        </Item>
        <Item key="Custom price level">
          <addfield key="Formula" type="double" controlType="Formula" />
        </Item>
      </AdvancedType>
      <AdvancedType key="sizeFormula">
        <Item key="Define own size">
          <addfield key="value" type="double" controlType="editbox" defaultValue="0.1" />
        </Item>
        <Item key="Use global Money management" />
        <Item key="Use from variable">
          <addfield key="value" type="double" controlType="comboVar" />
        </Item>
        <Item key="Use formula">
          <addfield key="value" type="double" controlType="Formula" />
        </Item>
      </AdvancedType>
      <AdvancedType key="closeSizeFormula">
        <Item key="Full position" />
        <Item key="Percentage">
          <addfield key="percentage" type="int" minValue="1" maxValue="100" controlType="editbox" defaultValue="100" step="0.1" postfix="%" />
        </Item>
        <Item key="Use global Money management" />
        <Item key="Use from variable">
          <addfield key="value" type="double" controlType="comboVar" />
        </Item>
        <Item key="Use formula">
          <addfield key="value" controlType="formula" />
        </Item>
      </AdvancedType>
    </AdvancedTypes>
