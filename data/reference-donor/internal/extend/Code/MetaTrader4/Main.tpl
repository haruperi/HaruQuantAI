int OnInit() {
   VerboseLog("--------------------------------------------------------");
   VerboseLog("Starting the EA");
   g_lastBg = GetChartBg();

   if(!checkComments()){
      return(INIT_FAILED);
   }

   gPointCoef = calculatePointCoef(Symbol());

   VerboseLog("--------------------------------------------------------");

   if(sqDisplayInfoPanel) {
     sqInitInfoPanel();
   }

   sqCreateDirectionButtons();

   SQTime = new CSQTime();

   if(!IsTesting() && !IsOptimization()) {                                         
      initTimer();
   }
         
   if(InitialCapital == 0) {
      initialBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   } else {
      initialBalance = InitialCapital;
   }
   
   <@printTradingOptionsInit />

   <@correctSubchartSymbols />

<#if usesCOTData == "true">
   <#list cotIdentifiers as cotId>
   sqCOTRegister(${cotRewriteCode("\"" + cotId + "\"")});
   </#list>
   sqCOTInitialLoad();

</#if>
<#if getRulesCountForEvent("OnInit") gt 0 >
   // OnInit  rules
<@printRulesForEvent "OnInit" />
</#if>

   double minDistanceMT = NormalizeDouble(MarketInfo(Symbol(), MODE_STOPLEVEL) * MarketInfo(Symbol(), MODE_POINT), Digits);
   double minDistanceSQ = NormalizeDouble(sqMinDistance * sqGetPointCoef(Symbol()), Digits);
   
   if(minDistanceSQ < minDistanceMT){
      VerboseLog("--------------------------------------------------------");
      VerboseLog("Warning! Min distance of this symbol is greater than min distance set in SQ! The backtest results may differ");
      VerboseLog("MT min distance: ", DoubleToStr(minDistanceMT), ", SQ min distance: ", DoubleToStr(minDistanceSQ));
      VerboseLog("--------------------------------------------------------");
   }

   //Show all subchart symbols in market watch
   <@showSymbolsInMarketWatch />

   <#if usesCOT>
   // COT: no new trades until the COT data is loaded; SqCOTDownloader is started when the data is missing or old
   if(SqCOT_EnsureDataAvailable(COTLicenseCode)) {
      if(!sqCOTCheckSymbols()) {
         return(INIT_FAILED);
      }
   }
   else if(SqCOT_IsTester()) {
      return(INIT_FAILED);
   }
   </#if>

   return(0);
}

