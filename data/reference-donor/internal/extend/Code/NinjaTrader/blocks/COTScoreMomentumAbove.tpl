<#assign cs><@printParam block "#CotSymbol#" /></#assign>(SqCOTScore(${cotSymbolInput(cs)}, <@printCIShift block shift />) - SqCOTScore(${cotSymbolInput(cs)}, SqCOTWeeksAgo(<@printCIShift block shift />, <@printParam block "#MomentumLookback#" />)) > <@printParam block "#MomentumThreshold#" /> && SqCOTScore(${cotSymbolInput(cs)}, <@printCIShift block shift />) > <@printParam block "#LevelThreshold#" />)