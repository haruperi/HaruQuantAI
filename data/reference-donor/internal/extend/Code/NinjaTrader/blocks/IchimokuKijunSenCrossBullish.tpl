<#-- Price crosses above Kijun-sen (Open below, Close above). #SignalStrength#: strong=Kijun above cloud,
     neutral=Kijun above cloud bottom. Parity with IchimokuKijunSenCrossBullish.java. -->
<@compress_single_line>(<@printSeriesAt block "0"><@printSeries block "Open" /></@printSeriesAt> < sqRound(<@printIchimokuValueAt block "1" "0" />, 6) && <@printSeriesAt block "0"><@printSeries block "Close" /></@printSeriesAt> > sqRound(<@printIchimokuValueAt block "1" "0" />, 6)<#if getParam(block, "#SignalStrength#", "1") == "2"> && sqRound(<@printIchimokuValueAt block "1" "0" />, 6) > Math.Max(sqRound(<@printIchimokuValueAt block "2" "0" />, 6), sqRound(<@printIchimokuValueAt block "3" "0" />, 6))<#elseif getParam(block, "#SignalStrength#", "1") == "1"> && sqRound(<@printIchimokuValueAt block "1" "0" />, 6) > Math.Min(sqRound(<@printIchimokuValueAt block "2" "0" />, 6), sqRound(<@printIchimokuValueAt block "3" "0" />, 6))</#if>)</@compress_single_line>