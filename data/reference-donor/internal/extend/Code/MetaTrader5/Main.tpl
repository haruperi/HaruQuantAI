//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick() {
<#if isBrazilianVersion>
   //--- Check if there has been a closing auction today
   if (TimeToString(TimeCurrent(),TIME_DATE) == dateOfLastClosingAuction){  // If there has already been a closing auction today, do not accept any more orders
      return;    // there was a closing auction today
   }

   //--- Check if the symbol is actively trading or is up for auction
   MqlTick lastTick;
   if (SymbolInfoTick(_Symbol, lastTick)){
      if (lastTick.volume == 0 || lastTick.bid >= lastTick.ask){ // if the tick volume is zero or the bid is greater than or equal to the ask
         if (getHHMM(TimeToString(TimeCurrent(),TIME_MINUTES)) >=  getHHMM(timeCloseToTheClosingAuction)){ // If there is an auction after dateOfLastClosingAuction it will be considered a closing auction
             dateOfLastClosingAuction = TimeToString(TimeCurrent(),TIME_DATE);                            // set this day to not accept any more orders
         }
         return; // Symbol at auction
      }
   }
</#if>

   //--- Do we have enough bars to work with?
   if(Bars(_Symbol,_Period) < minBars) {   // if total bars is less than minBars
      Alert(StringFormat("NOT ENOUGH DATA: Less Bars than %d", minBars));
      return;
   }

   //--- Get the details of the latest 2 bars
   if(CopyRates(_Symbol, _Period, 0, 2, mrate) < 2) {
      Alert("Error copying rates/history data - error:", GetLastError(), "!!");
      ResetLastError();
      return;
   }
   
   IndicatorLoadedWithoutError = true;
   ZeroMemory(mrequest);      // Initialization of mrequest structure
 
   if(!timerInitialized) initTimer();

   checkBarOpen();
   
   if(sqDisplayInfoPanel && InpsqDisplayInfoPanel) {
      sqTextFillOpens();
      if(_sqIsBarOpen) {
         sqTextFillTotals();   
      }  
   }
    
	 <#list MagicNumbersList as magicNumber>
   sqManagePositions(${magicNumber});
	 </#list>    
   
   openingOrdersAllowed = sqHandleTradingOptions();

<#if usesCOTData == "true">
   // existing positions are already managed above, only new entries wait for COT data
   if(!sqCOTReady()) {
      return;
   }

</#if>
<#if usesCOT>
   // existing positions are already managed above, new entries wait until the COT data is loaded
   if(!sqCOTTradingAllowed()) {
      return;
   }

</#if>
   ulong _ticket;
   double openPrice;
   double sl, pt;
   double size;
   
<#if getRulesCountForEvent("OnBarUpdate") gt 0 >
<@printRulesForEvent "OnBarUpdate" />
</#if>

   if (_sqIsBarOpen == true && isNettingMode()){    
      checkOpenPositions();
   }
}      

