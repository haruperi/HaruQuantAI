<#-- Detect COT block usage by scanning strategy XML --><#macro _scanCOT_EL node><#list node?children as c><#if c?node_type == 'element'><#if (c.@mI[0]!"")=="COT" || (c.@cdataIndyName[0]!"")?contains("_52W") || (c.@cdataIndyName[0]!"")?contains("_156W")><#global usesCOT = true><#else><@_scanCOT_EL c /></#if></#if></#list></#macro><#global usesCOT = false><@_scanCOT_EL doc.StrategyFile.Strategy.Rules />
<@cotCollectSymbols doc.StrategyFile.Strategy "el" />
<#if cotCheckedSymbols?has_content><#global usesCOT = true></#if>
<#if usesCOT>
// COT data provided by SpreadCharts.com
</#if>


<@elPrintInputs />

<@elPrintVars />
<#if usesCOT>

// =================================================================
// COT DATA DOWNLOAD
// =================================================================
// The first bar downloads the COT data with COTLicenseCode when it is missing or older than 7 days, then the
// strategy checks once a day for a new weekly report. MultiCharts downloads at once. TradeStation downloads in
// the background; without any COT data the first start stops the strategy until the download has finished.
If COTCheckDate = 0 or (LastBarOnChart and Date <> COTCheckDate) Then begin
	COTCheckDate = Date;
	COTDataReady = SQ_COT_EnsureData(COTLicenseCode, "");
end;
</#if>
<#if cotCheckedSymbols?has_content>

// =================================================================
// COT DATA CHECK
// =================================================================
// A COTSymbol input naming a market without a COT data file stops the strategy. On the last bar every
// market that has a file returns a value; SQ_COT_GetValue returns -1 only when the file is missing.
If LastBarOnChart Then begin
<#list cotCheckedSymbols as cotSymbol>
<#assign cotInput = cotSymbolInput(cotSymbol)>
	If SQ_COT_GetValue(${cotInput} + "_52W", 0, 0, "") < 0 Then
		RaiseRunTimeError(${cotMissingSymbolMessage(cotInput)});
</#list>
end;
</#if>

<#if getRulesCountForEvent("OnInit") gt 0 >
