<#--
  COTMultiFieldCombo.java: the mean of the fields whose switch is on - hedger CPI plus the inverted
  speculator CPI, small trader CPI and speculator CTI - and 0.5 when no field is on.
--><#assign sh><@printShiftAsParam block shift /></#assign><#assign cs><@printParam block "#CotSymbol#" /></#assign><#assign p><@printParam block "#Period#" /></#assign><#assign id = cotIdentifier(cs, p?upper_case)><#assign terms = []><#if ("" + getParam(block, "#UseCpihedg#", "true"))?trim?lower_case == "true"><#assign terms = terms + ["SQ_COT_GetValue(" + id + ", 0, " + sh + ", \"\")"]></#if><#if ("" + getParam(block, "#UseCpispec#", "true"))?trim?lower_case == "true"><#assign terms = terms + ["(1.0 - " + "SQ_COT_GetValue(" + id + ", 2, " + sh + ", \"\")" + ")"]></#if><#if ("" + getParam(block, "#UseCpismall#", "true"))?trim?lower_case == "true"><#assign terms = terms + ["(1.0 - " + "SQ_COT_GetValue(" + id + ", 4, " + sh + ", \"\")" + ")"]></#if><#if ("" + getParam(block, "#UseCtispec#", "true"))?trim?lower_case == "true"><#assign terms = terms + ["(1.0 - " + "SQ_COT_GetValue(" + id + ", 3, " + sh + ", \"\")" + ")"]></#if><#if terms?size == 0>0.5<#else>Round((${terms?join(" + ")}) / ${terms?size}.0, 6)</#if>