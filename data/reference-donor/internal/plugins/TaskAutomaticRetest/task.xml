				<OptimizePeriods>true</OptimizePeriods>
				<OptimizeExitTypes>true</OptimizeExitTypes>
			</Settings>
			<AcceptanceSettings>
				<Conditions CrossCheck="WalkForwardOptimization" thresholdPct="50" />
			</AcceptanceSettings>
		</WalkForwardOptimization>
		<WalkForwardMatrix use="false">
