<Task>
	<Settings>
        <AutomaticPortfolioBuilder>
          <SearchType>bruteforce</SearchType>
          <GenPopulationSize>100</GenPopulationSize>
          <GenGenerations>700</GenGenerations>
          <GenRunContinually>false</GenRunContinually>
          <GenRestartAfterStagnation>true</GenRestartAfterStagnation>
          <GenGenerationLimit>500</GenGenerationLimit>
          <MinStrategies>2</MinStrategies>
          <MaxStrategies>8</MaxStrategies>
          <MaxStrategiesDatabank>100</MaxStrategiesDatabank>
          <MaxStrategiesSector>3</MaxStrategiesSector>
          <DateRange>full</DateRange>
          <DateRangeFrom>2023.11.14</DateRangeFrom>
          <DateRangeTo>2023.11.14</DateRangeTo>
          <DateRangeIsPct>70</DateRangeIsPct>
          <DateRangeReverse>false</DateRangeReverse>
          <FitnessType>NetProfitIS</FitnessType>
          <CorrMax>0.3</CorrMax>
          <CorrType>ProfitLoss</CorrType>
          <CorrSampleType>10</CorrSampleType>
          <CorrPeriod>10</CorrPeriod>
          <CorrAllowNegative>true</CorrAllowNegative>
          <CorrAddEmptyPeriods>false</CorrAddEmptyPeriods>
          <Conditions>
            <Condition use="true">
              <Left-Side valueType="column">
                <Column-Value column="ReturnDDRatio" format="Decimal2" resultType="portfolio" subresult="30" direction="0" sampleType="127" plType="10" confidenceLevel="50" market="1" class="ReturnDDRatio" />
              </Left-Side>
              <Comparator value="&gt;" />
              <Right-Side valueType="numeric">
                <Numeric-Value value="4" />
              </Right-Side>
            </Condition>
            <Condition use="true">
              <Left-Side valueType="column">
                <Column-Value column="ProfitFactor" format="Decimal2" resultType="portfolio" subresult="30" direction="0" sampleType="127" plType="10" confidenceLevel="50" market="1" class="ProfitFactor" />
              </Left-Side>
              <Comparator value="&gt;" />
              <Right-Side valueType="numeric">
                <Numeric-Value value="1.3" />
              </Right-Side>
            </Condition>
          </Conditions>
		  <MoneyManagement>
			  <InitialCapital>100000</InitialCapital>
			  <Method type="RiskFixedBalancePct" use="true">
				<Params>
				  <Param key="Risk" className="RiskFixedBalancePct">5</Param>
				  <Param key="Decimals" className="RiskFixedBalancePct">1</Param>
				  <Param key="LotsIfNoMM" className="RiskFixedBalancePct">1</Param>
				  <Param key="MaxLots" className="RiskFixedBalancePct">5</Param>
				</Params>
			  </Method>
		  </MoneyManagement>
        </AutomaticPortfolioBuilder>
        <Databanks>
          <Databank label="Input databank" name="Input" value="Simple strategies" />
          <Databank label="Output databank" name="Output" value="Results" />
        </Databanks>
	</Settings>
</Task>
