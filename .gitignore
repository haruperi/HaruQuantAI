artifacts/logs/
*.log
*.log.*
log_*.txt

# ============================================================================
# Data Files (market data, exports, results)
# ============================================================================
# Market data directories
/data/
!app/data/
datasets/
historical_data/

# Backtest results and exports
results/
exports/
/reports/**
!/reports/**/
!/reports/**/README.md
output/

# Temporary data
temp_data/
tmp/
cache/

# CSV, Parquet, Arrow, and binary data files
*.csv
*.parquet
*.pq
*.arrow
*.dat
data/*.dat

# Root data contains source/control files alongside ignored runtime-heavy stores.
!/data/
!/data/**/
!/data/**/*.py
!/data/**/*.json
!/data/**/*.md
!/data/**/*.sql
/data/cache/
/data/data/
/data/knowledge_db/
/data/market_data/
/data/saved/
/data/simulations/
/data/states/

# DATA owns this source package; global dataset-artifact exclusions do not apply.
!app/services/data/datasets/
!app/services/data/datasets/**
# The source-package exception above must not re-admit generated Python bytecode.
app/services/data/datasets/**/__pycache__/
app/services/data/datasets/**/*.py[cod]

# Strategy signal-audit frames written by tests/strategy/usage/10_strategy_library.py
tests/strategy/usage/signal_audit/

