[importlinter]
root_package = app

[importlinter:contract:kernel-independent]
name = Kernel must not import application layers
type = forbidden
source_modules =
    app.kernel
forbidden_modules =
    app.contracts
    app.services
    app.api
    app.composition

[importlinter:contract:contracts-independent]
name = Contracts must not import service implementations or APIs
type = forbidden
source_modules =
    app.contracts
forbidden_modules =
    app.services
    app.api
    app.composition

[importlinter:contract:api-does-not-import-services]
name = Public API resolves capabilities rather than concrete service implementations
type = forbidden
source_modules =
    app.api
forbidden_modules =
    app.services

[importlinter:contract:features-independent]
name = Service feature packages must be strictly decoupled from each other
type = independence
modules =
    app.services.broker.mock_feed
    app.services.data.historical_bars
    app.services.system.storage
