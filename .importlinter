[importlinter]
root_package = app

[importlinter:contract:kernel-independent]
name = Kernel must not import application layers
type = forbidden
source_modules =
    app.kernel
forbidden_modules =
    app.contracts
    app.services
    app.composition

[importlinter:contract:contracts-independent]
name = Contracts must not import service implementations or composition
type = forbidden
source_modules =
    app.contracts
forbidden_modules =
    app.services
    app.composition
