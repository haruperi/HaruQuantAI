        "kaleido",
        "litellm",
        "lmdb",
        "matplotlib",
        "mypy",
        "nbclassic",
        "numba",
        "passlib",
        "plotly",
        "psutil",
        "psycopg",
        "pyarrow",
        "pyautogen",
        "pydantic",
        "pylint",
        "pytest",
        "pytz",
        "qrcode",
        "quantstats",
        "scikit",
        "scipy",
        "seaborn",
        "setuptools",
        "sqlalchemy",
        "tqdm",
        "uvicorn",
        "vertexai",
        "yfinance"
