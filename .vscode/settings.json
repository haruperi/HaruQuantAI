    "files.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/.benchmarks": true,
    "**/.github": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.tmp_agentic_examples": true,
    "**/.tmp_pytest_runtime": true,
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/*.ruff_cache": true,
    "**/*.claude": true,
    "**/htmlcov": true,
    "**/build": true,
    "**/.coverage": true,
    "**/.coveragerc_folder": true
}
}
