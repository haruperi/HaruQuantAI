{
    "python.defaultInterpreterPath": "${workspaceFolder}\\venv\\Scripts\\python.exe",
    "cSpell.words": [
        "anywidget",
        "bokeh",
        "CCXT",
        "chromadb",
        "dateparser",
        "dotenv",
        "fastparquet",
        "genai",
        "generativeai",
