{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "cSpell.words": [
    "anywidget",
    "bokeh",
    "CCXT",
    "chromadb",
    "dateparser",
    "dotenv",
    "fastparquet",
    "genai",
    "generativeai",
    "httpx",
    "imageio",
    "ipywidgets",
    "isort",
    "kaleido",
    "litellm",
    "lmdb",
    "matplotlib",
    "mypy",
    "nbclassic",
    "numba",
    "passlib",
    "plotly",
    "psutil",
    "psycopg",
    "pyarrow",
    "pyautogen",
    "pydantic",
    "pylint",
    "pytest",
    "pytz",
    "qrcode",
    "quantstats",
    "scikit",
    "scipy",
    "seaborn",
    "setuptools",
    "sqlalchemy",
    "tqdm",
    "uvicorn",
    "vertexai",
    "yfinance"
  ],
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.autoComplete.extraPaths": ["${workspaceFolder}"],
  "python.languageServer": "Default",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/_pyrefly_virtual_/**",
    "C:/_pyrefly_virtual_/**", "**/node_modules", "**/__pycache__", "**/.*", ".venv"
  ],
  "python.analysis.ignore": [
    "**/_pyrefly_virtual_/**",
    "C:/_pyrefly_virtual_/**"
  ],
  "pyrefly.enabled": false,
  "pyrefly.diagnostics.enabled": false,
  "pyrefly.displayDiagnostics": false,
  "files.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/.benchmarks": true,
    "**/.github": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.tmp_agentic_examples": true,
    "**/.tmp_pytest_runtime": true,
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/*.ruff_cache": true,
    "**/*.claude": true,
    "**/htmlcov": true,
    "**/build": true,
    "**/.coverage": true,
    "**/.coveragerc_folder": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/_pyrefly_virtual_/**": true
  }
}
