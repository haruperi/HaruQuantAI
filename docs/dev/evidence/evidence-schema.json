{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HaruQuantAI Feature Acceptance Evidence Schema",
  "type": "object",
  "required": [
    "feature_id",
    "task_id",
    "status",
    "owner_specification",
    "baseline_commit",
    "acceptance_commit",
    "requirements",
    "catalogue_entries",
    "stages",
    "commands",
    "review"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^FEAT-[A-Z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "IN_PROGRESS"
      ]
    },
    "owner_specification": {
      "type": "string",
      "pattern": "^(app|docs)/.+README\\.md$"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "acceptance_commit": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "WAIVED"
            ]
          },
          "evidence_target": {
            "type": "string"
          }
        }
      }
    },
    "catalogue_entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stages": {
      "type": "object",
      "required": [
        "contract",
        "provider",
        "composition",
        "interfaces",
        "ui",
        "end_to_end"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": { "$ref": "#/$defs/stage" },
        "provider": { "$ref": "#/$defs/stage" },
        "composition": { "$ref": "#/$defs/stage" },
        "interfaces": { "$ref": "#/$defs/stage" },
        "ui": { "$ref": "#/$defs/stage" },
        "end_to_end": { "$ref": "#/$defs/stage" }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "reviewer_verdict",
        "reviewer_notes"
      ],
      "properties": {
        "reviewer_verdict": {
          "type": "string",
          "enum": [
            "APPROVED",
            "CHANGES_REQUESTED"
          ]
        },
        "reviewer_notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "WAIVED", "NOT_APPLICABLE"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
