  "id": "data-source-darwinex",
  "name": "Darwinex Data Feed",
  "version": "1.0.0",
  "description": "Darwinex institutional tick and bar market data provider plugin",
  "author": "HaruQuantAI",
  "slot": "data.provider",
  "entrypoint": "adapter:create_adapter",
  "dependencies": [],
  "capabilities": [],
