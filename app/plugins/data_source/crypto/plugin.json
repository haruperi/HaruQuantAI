{
  "manifest_version": 1,
  "id": "data-source-crypto",
  "name": "Cryptocurrency Exchanges",
  "version": "1.0.0",
  "description": "Multi-exchange cryptocurrency historical data feed provider plugin (Binance, Bitfinex, Coinbase Pro, Poloniex)",
  "author": "HaruQuantAI",
  "slot": "data.provider",
  "entrypoint": "adapter:create_adapter",
  "dependencies": [],
  "capabilities": [],
  "enabled": true,
  "metadata": {
    "provider_name": "Binance",
    "display_name": "Binance Crypto Exchange",
    "asset_classes": ["Crypto"],
    "timeframes": ["M1", "M5", "M15", "H1", "D1"],
    "requires_auth": false,
    "rate_limit_rps": 20.0
  }
}
