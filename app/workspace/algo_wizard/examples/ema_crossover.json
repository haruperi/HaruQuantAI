{
  "summary": {
    "example_id": "ema_crossover",
    "name": "EMA Crossover",
    "category": "trend",
    "description": "Trend-following dual EMA crossover strategy entering long when the fast EMA crosses above the slow EMA and short on the reverse.",
    "tags": [
      "ema",
      "crossover",
      "trend",
      "h1"
    ]
  },
  "document": {
    "schema_version": "1.0.0",
    "strategy": {
      "id": "example_ema_crossover",
      "name": "EMA Crossover",
      "description": "Trend-following dual EMA crossover strategy entering long when the fast EMA crosses above the slow EMA and short on the reverse.",
      "enabled": true,
      "metadata": {},
      "universe": {
        "mode": "explicit",
        "symbols": [
          "EURUSD"
        ]
      },
      "timeframe": {
        "primary": "H1",
        "additional": []
      },
      "parameters": {
        "fast_period": {
          "type": "int",
          "default": 12,
          "min": 2,
          "max": 100,
          "step": 1,
          "optimize": false,
          "description": "Fast EMA lookback period"
        },
        "slow_period": {
          "type": "int",
          "default": 26,
          "min": 5,
          "max": 250,
          "step": 1,
          "optimize": false,
          "description": "Slow EMA lookback period"
        }
      },
      "variables": {},
      "money_management": {
        "type": "fixed_size",
        "size": {
          "type": "value",
          "value": 1.0,
          "value_type": "float"
        },
        "amount": null,
        "percent": null,
        "risk_pct": null,
        "max_lots": null
      },
      "risk_management": {
        "max_open_positions": 1,
        "max_daily_loss_pct": null,
        "max_drawdown_pct": null,
        "allow_opposite_signals": false,
        "default_stop_loss": {
          "type": "none",
          "value": null,
          "period": null,
          "multiplier": null,
          "indicator": null,
          "expression": null
        },
        "default_take_profit": {
          "type": "none",
          "value": null,
          "period": null,
          "multiplier": null,
          "multiple": null,
          "expression": null
        }
      },
      "trade_management": {
        "breakeven": null,
        "trailing_stop": null,
        "time_stop_bars": null,
        "partial_exits": []
      },
      "trading_options": {
        "timezone": "UTC",
        "exit_at_end_of_day": false,
        "end_of_day_time": null,
        "exit_on_friday": false,
        "friday_exit_time": null,
        "limit_time_range": false,
        "time_range_start": null,
        "time_range_end": null,
        "max_trades_per_day": null,
        "min_distance_from_market_pips": 0.0
      },
      "rules": [
        {
          "type": "rule",
          "id": "long_entry_rule",
          "name": "Long Entry on Fast EMA Cross Above Slow EMA",
          "priority": 10,
          "enabled": true,
          "event": {
            "type": "on_bar_close",
            "timeframe": "$current_timeframe",
            "symbol": "$current_symbol"
          },
          "when": {
            "type": "logical",
            "operator": "and",
            "conditions": [
              {
                "type": "not",
                "condition": {
                  "type": "state",
                  "state": "position.is_long"
                }
              },
              {
                "type": "comparison",
                "operator": "crosses_above",
                "left": {
                  "type": "indicator",
                  "name": "indicator.ema",
                  "inputs": {},
                  "params": {
                    "period": {
                      "type": "parameter",
                      "name": "fast_period"
                    }
                  },
                  "output": "main",
                  "context": {
                    "symbol": "$current_symbol",
                    "timeframe": "$current_timeframe",
                    "shift": 0
                  }
                },
                "right": {
                  "type": "indicator",
                  "name": "indicator.ema",
                  "inputs": {},
                  "params": {
                    "period": {
                      "type": "parameter",
                      "name": "slow_period"
                    }
                  },
                  "output": "main",
                  "context": {
                    "symbol": "$current_symbol",
                    "timeframe": "$current_timeframe",
                    "shift": 0
                  }
                }
              }
            ]
          },
          "then": [
            {
              "type": "action",
              "action": "enter_market",
              "side": "long",
              "size": null,
              "stop_loss": null,
              "take_profit": null,
              "comment": "EMA Cross Long",
              "magic_number": null
            }
          ],
          "else_then": []
        },
        {
          "type": "rule",
          "id": "short_entry_rule",
          "name": "Short Entry on Fast EMA Cross Below Slow EMA",
          "priority": 20,
          "enabled": true,
          "event": {
            "type": "on_bar_close",
            "timeframe": "$current_timeframe",
            "symbol": "$current_symbol"
          },
          "when": {
            "type": "logical",
            "operator": "and",
            "conditions": [
              {
                "type": "not",
                "condition": {
                  "type": "state",
                  "state": "position.is_short"
                }
              },
              {
                "type": "comparison",
                "operator": "crosses_below",
                "left": {
                  "type": "indicator",
                  "name": "indicator.ema",
                  "inputs": {},
                  "params": {
                    "period": {
                      "type": "parameter",
                      "name": "fast_period"
                    }
                  },
                  "output": "main",
                  "context": {
                    "symbol": "$current_symbol",
                    "timeframe": "$current_timeframe",
                    "shift": 0
                  }
                },
                "right": {
                  "type": "indicator",
                  "name": "indicator.ema",
                  "inputs": {},
                  "params": {
                    "period": {
                      "type": "parameter",
                      "name": "slow_period"
                    }
                  },
                  "output": "main",
                  "context": {
                    "symbol": "$current_symbol",
                    "timeframe": "$current_timeframe",
                    "shift": 0
                  }
                }
              }
            ]
          },
          "then": [
            {
              "type": "action",
              "action": "enter_market",
              "side": "short",
              "size": null,
              "stop_loss": null,
              "take_profit": null,
              "comment": "EMA Cross Short",
              "magic_number": null
            }
          ],
          "else_then": []
        }
      ]
    }
  }
