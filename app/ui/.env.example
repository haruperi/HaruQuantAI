# Frontend runtime configuration (no secrets).
# Production: set NEXT_PUBLIC_API_URL to the canonical gateway origin.
# Development: leave it empty to use the same-origin /api rewrite proxy in
# next.config.mjs, which forwards /api/* to BACKEND_URL (default 127.0.0.1:8000).

NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8000
