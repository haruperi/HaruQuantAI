          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "content_hash"
      ],
      "title": "VersionRef",
      "type": "object"
    }
