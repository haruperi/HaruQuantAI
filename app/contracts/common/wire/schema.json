        "evaluated_at"
      ],
      "title": "ValidationOutcome",
      "type": "object"
    },
    "ValidationReason": {
      "additionalProperties": false,
      "description": "Structured validation reason code with severity and corrective actions.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "corrective_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
