        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "type": "string"
    },
    "Timeframe": {
      "additionalProperties": false,
      "description": "Positive multiple of a supported market-time unit.",
      "properties": {
        "multiple": {
          "minimum": 1,
          "title": "Multiple",
          "type": "integer"
        },
        "unit": {
          "enum": [
            "MINUTE",
            "DAY",
            "WEEK",
            "MONTH"
