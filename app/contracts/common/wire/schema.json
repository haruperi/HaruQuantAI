          "type": "string"
        }
      },
      "required": [
        "unit",
        "multiple"
      ],
      "title": "Timeframe",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "description": "Machine-readable validation issue.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
